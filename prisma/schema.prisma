datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  email        String        @unique
  password     String
  cpf          String        @unique
  birthDate    DateTime
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String
  category    String    @default("Outros")
  date        DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("PAGO")
  costCenter  String    @default("Geral")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
