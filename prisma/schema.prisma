datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String        @id @default(uuid())
  fullName           String?
  fullNameEncrypted  String?
  email              String?       @unique
  emailEncrypted     String?
  emailLookupHash    String?       @unique
  password           String
  cpf                String?       @unique
  cpfEncrypted       String?
  cpfLookupHash      String?       @unique
  birthDate          DateTime?
  birthDateEncrypted String?
  createdAt          DateTime      @default(now())
  memberships        Membership[]
  transactions       Transaction[]
  invitations        Invitation[]  @relation("InvitationCreator")
  passwordResetTokens PasswordResetToken[]
}

model Company {
  id            String        @id @default(uuid())
  name          String
  workspaceType String        @default("EMPRESA")
  createdAt     DateTime      @default(now())
  memberships   Membership[]
  transactions  Transaction[]
  invitations   Invitation[]
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      String   @default("LEITURA")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
}

model Invitation {
  id              String    @id @default(uuid())
  companyId       String
  invitedById     String
  email           String?
  emailEncrypted  String?
  emailLookupHash String?
  role            String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, emailLookupHash])
  @@index([companyId, acceptedAt])
}

model Transaction {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String
  category    String    @default("Outros")
  date        DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("PAGO")
  costCenter  String    @default("Geral")
  companyId   String
  userId      String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([companyId, date])
}

model LoginRateLimit {
  id              String   @id
  attempts        Int      @default(1)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
